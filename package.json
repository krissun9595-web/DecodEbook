{
  "name": "decodebook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:source-index && npm run test:structure-analysis && npm run test:reader-structure && npm run test:audio-book-formatting && npm run test:rollback-version",
    "test:rollback-version": "esbuild tests/rollbackVersion.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=/tmp/decodebook-rollbackVersion.test.mjs && node /tmp/decodebook-rollbackVersion.test.mjs",
    "test:source-index": "esbuild tests/sourceIndex.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=/tmp/decodebook-sourceIndex.test.mjs && node /tmp/decodebook-sourceIndex.test.mjs",
    "test:structure-analysis": "esbuild tests/structureAnalysis.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=/tmp/decodebook-structureAnalysis.test.mjs && node /tmp/decodebook-structureAnalysis.test.mjs",
    "test:reader-structure": "esbuild tests/readerStructure.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=/tmp/decodebook-readerStructure.test.mjs && node /tmp/decodebook-readerStructure.test.mjs",
    "test:audio-book-formatting": "esbuild tests/audioBookFormatting.test.ts --bundle --packages=external --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/decodebook-audioBookFormatting.test.mjs && node node_modules/.cache/decodebook-audioBookFormatting.test.mjs",
    "deploy": "npm run deploy:staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy",
    "dev:worker": "wrangler dev --env staging",
    "dev:worker:production": "wrangler dev"
  },
  "dependencies": {
    "@google/genai": "1.30.0",
    "@supabase/supabase-js": "^2.101.1",
    "docx": "8.5.0",
    "html-to-image": "^1.11.13",
    "jspdf": "2.5.1",
    "jszip": "3.10.1",
    "lucide-react": "^0.555.0",
    "matter-js": "^0.20.0",
    "motion": "^12.41.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svg2pdf.js": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.0.0"
  }
}
