{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decodebook0219",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "vars": {
        "ENVIRONMENT": "staging"
      }
    }
  }
}
